@inject Known.Web.Services.DocumentationCatalog Documentation

<section class="known-site-section" id="docs">
    <div class="known-site-section-head">
        <span>Documentation</span>
        <h2>官网内置文档中心，直接阅读仓库中的 Markdown</h2>
        <p>文档导航来自 <code>docs/SUMMARY.md</code>，正文直接渲染仓库里的 Markdown 文件，官网内容与源码文档保持同一份来源。</p>
    </div>
    <div class="known-site-docs-preview">
        <article class="known-site-card known-site-docs-callout">
            <span class="known-site-eyebrow">官方文档</span>
            <h3>@Documentation.DocumentCount 篇文档，按章节组织</h3>
            <p>适合初学者、业务开发者、平台开发者和二次开发团队，支持从首页跳转到完整文档阅读体验。</p>
            <div class="known-site-actions">
                <a class="known-site-btn primary" href="/docs">进入文档中心</a>
            </div>
        </article>
        <div class="known-site-grid known-site-grid-3">
            @foreach (var docPage in Documentation.GetHighlights(6))
            {
                <article class="known-site-card known-site-doc-card">
                    <span class="known-site-tag">@docPage.SectionTitle</span>
                    <h3><a href="@Documentation.GetUrl(docPage.Route)">@docPage.Title</a></h3>
                    <p>@docPage.Excerpt</p>
                </article>
            }
        </div>
    </div>
</section>
