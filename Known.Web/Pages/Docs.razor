@page "/docs"
@page "/docs/{*DocumentPath}"
@inject Known.Web.Services.DocumentService Documents

<PageTitle>@PageTitleText</PageTitle>
<HeadContent>
    <meta name="description" content="Known Framework 官方文档中心，内容直接来自仓库中的 Markdown 文档。" />
    <meta property="og:title" content="Known Framework 文档中心" />
</HeadContent>

<SiteFrame Current="docs" BodyClass="known-site-docs-shell" MainClass="known-site-docs-main">
        <aside class="known-docs-sidebar">
            <div class="known-docs-sidebar-card">
                <div class="known-docs-sidebar-head">
                    <span class="known-site-eyebrow">Documentation</span>
                    <h2>Known 文档中心</h2>
                    <p>文档内容直接来自项目中的 <code>docs</code> 目录。</p>
                </div>

                <div class="known-docs-search-box">
                    <input @bind="SearchTerm" @bind:event="oninput" class="known-docs-search-input" type="search" placeholder="搜索文档、章节、能力点" />
                </div>

                @if (HasSearch)
                {
                    <section class="known-docs-nav-section known-docs-search-results">
                        <h3>搜索结果</h3>
                        @if (SearchGroups.Count == 0)
                        {
                            <p class="known-docs-search-empty">没有匹配结果。</p>
                        }
                        else
                        {
                            @foreach (var group in SearchGroups)
                            {
                                <div class="known-docs-search-group">
                                    <h4>@group.Title</h4>
                                    @foreach (var item in group.Items)
                                    {
                                        <a class="@(IsActive(item.Route) ? "known-docs-link active" : "known-docs-link")" href="@Documents.GetUrl(item.Route)">
                                            <strong>@((MarkupString)item.TitleHtml)</strong>
                                            <span>@((MarkupString)item.ExcerptHtml)</span>
                                        </a>
                                    }
                                </div>
                            }
                        }
                    </section>
                }
                else
                {
                    <div class="known-docs-nav-wrap">
                        @foreach (var docSection in Documents.Sections)
                        {
                            <details class="known-docs-nav-group" open="@IsSectionOpen(docSection)">
                                <summary class="known-docs-nav-summary">@docSection.Title</summary>
                                <div class="known-docs-nav-section">
                                    @foreach (var docPage in docSection.Pages)
                                    {
                                        <a class="@(IsActive(docPage.Route) ? "known-docs-link active" : "known-docs-link")" data-doc-link="@docPage.Route" data-doc-active="@IsActive(docPage.Route)" href="@Documents.GetUrl(docPage.Route)">@docPage.Title</a>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                }
            </div>
        </aside>

        <section class="known-docs-content-wrap">
            @if (CurrentPage is null)
            {
                <article class="known-site-card known-docs-empty">
                    <h1>文档不存在</h1>
                    <p>当前地址没有对应的 Markdown 文件，请返回 <a href="/docs">文档中心</a> 继续浏览。</p>
                </article>
            }
            else
            {
                <header class="known-site-card known-docs-hero">
                    <div class="known-docs-hero-meta">
                        <span class="known-site-eyebrow">@CurrentPage.SectionTitle</span>
                        <span class="known-docs-hero-path">@CurrentPage.RelativePath</span>
                    </div>
                    <h1>@CurrentPage.Title</h1>
                    <p>@CurrentPage.Excerpt</p>
                </header>

                <article class="known-site-card known-docs-markdown">
                    @((MarkupString)CurrentPage.Html)
                </article>

                <div class="known-docs-pager">
                    @if (PreviousPage is not null)
                    {
                        <a class="known-site-card known-docs-pager-link" href="@Documents.GetUrl(PreviousPage.Route)">
                            <span>上一篇</span>
                            <strong>@PreviousPage.Title</strong>
                        </a>
                    }

                    @if (NextPage is not null)
                    {
                        <a class="known-site-card known-docs-pager-link align-right" href="@Documents.GetUrl(NextPage.Route)">
                            <span>下一篇</span>
                            <strong>@NextPage.Title</strong>
                        </a>
                    }
                </div>
            }
        </section>

        <aside class="known-docs-toc">
            @if (CurrentPage is not null)
            {
                <div class="known-docs-toc-card">
                    <span class="known-site-eyebrow">On this page</span>
                    <h3>当前页目录</h3>

                    @if (CurrentPage.Headings.Count == 0)
                    {
                        <p class="known-docs-search-empty">当前页没有可导航标题。</p>
                    }
                    else
                    {
                        @foreach (var heading in CurrentPage.Headings)
                        {
                            <a class="known-docs-toc-link level-@heading.Level" data-toc-link href="@GetHeadingUrl(heading.Id)">@heading.Title</a>
                        }
                    }
                </div>
            }
        </aside>
</SiteFrame>

@code {
    [Parameter]
    public string? DocumentPath { get; set; }

    private Known.Web.Services.DocPage? CurrentPage { get; set; }
    private Known.Web.Services.DocPage? PreviousPage { get; set; }
    private Known.Web.Services.DocPage? NextPage { get; set; }
    private string SearchTerm { get; set; } = string.Empty;
    private string PageTitleText => CurrentPage is null ? "Known 文档中心" : $"{CurrentPage.Title} - Known 文档中心";
    private bool HasSearch => !string.IsNullOrWhiteSpace(SearchTerm);
    private IReadOnlyList<Known.Web.Services.DocSearchGroup> SearchGroups => Documents.SearchGrouped(SearchTerm, 16);

    protected override void OnParametersSet()
    {
        CurrentPage = Documents.GetPage(DocumentPath);

        if (CurrentPage is null)
        {
            PreviousPage = null;
            NextPage = null;
            return;
        }

        PreviousPage = Documents.GetPrevious(CurrentPage.Route);
        NextPage = Documents.GetNext(CurrentPage.Route);
    }

    private bool IsActive(string route)
    {
        return CurrentPage?.Route.Equals(route, StringComparison.OrdinalIgnoreCase) == true;
    }

    private bool IsSectionOpen(Known.Web.Services.DocSection section)
    {
        return CurrentPage is not null && section.Pages.Any(page => string.Equals(page.Route, CurrentPage.Route, StringComparison.OrdinalIgnoreCase));
    }

    private string GetHeadingUrl(string headingId)
    {
        var pageUrl = CurrentPage is null ? "/docs" : Documents.GetUrl(CurrentPage.Route);
        return $"{pageUrl}#{headingId}";
    }
}
