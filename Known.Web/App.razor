<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="Known,Known Framework,Blazor,.NET,插件开发,低代码,跨平台,MAUI,WebAssembly" />
    <meta name="description" content="Known Framework 官方网站。Known 是基于 Blazor 的轻量级、跨平台、极易扩展的插件开发框架，支持 Server、WebAssembly、MAUI 等多端宿主。" />
    <base href="/" />
    <script>
        (function () {
            var key = 'known-theme';

            function readTheme() {
                try {
                    var stored = localStorage.getItem(key);
                    if (stored === 'light' || stored === 'dark') {
                        return stored;
                    }
                } catch (error) {
                }

                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }

            function applyTheme(theme) {
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.style.colorScheme = theme;

                try {
                    localStorage.setItem(key, theme);
                } catch (error) {
                }
            }

            var initialTheme = readTheme();
            applyTheme(initialTheme);

            window.knownTheme = {
                set: function (theme) {
                    applyTheme(theme === 'dark' ? 'dark' : 'light');
                },
                toggle: function () {
                    var currentTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
                    applyTheme(currentTheme === 'dark' ? 'light' : 'dark');
                }
            };
        })();
    </script>
    <link rel="stylesheet" href="css/app.css" />
    <HeadOutlet />
</head>
<body>
    <Routes />
</body>
</html>
