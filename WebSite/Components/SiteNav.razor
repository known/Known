<nav class="known-site-nav">
    <div class="known-site-nav-bar" data-nav-root>
        <a class="known-site-brand" href="/">
            <span class="known-site-brand-mark">K</span>
            <span>Known</span>
        </a>

        <button class="known-site-nav-menu" type="button" data-nav-toggle aria-expanded="false" aria-label="切换导航菜单">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>

        <div class="known-site-nav-links" data-nav-panel>
            <a class="@GetNavClass("home")" href="/">首页</a>
            <a class="@GetNavClass("features")" href="/features">框架特性</a>
            <a class="@GetNavClass("architecture")" href="/architecture">架构设计</a>
            <a class="@GetNavClass("start")" href="/start">快速开始</a>
            <a class="@GetNavClass("docs")" href="/docs">文档</a>
            <a class="@GetNavClass("ecosystem")" href="/ecosystem">生态社区</a>
        </div>

        <div class="known-site-nav-actions" data-nav-panel>
            <button class="known-theme-toggle" type="button" onclick="window.knownTheme.toggle()" aria-label="切换浅色或深色主题">
                <i class="fa-solid fa-moon known-theme-toggle-dark" aria-hidden="true"></i>
                <i class="fa-solid fa-sun known-theme-toggle-light" aria-hidden="true"></i>
            </button>
            <a class="known-site-nav-github" href="https://github.com/known/Known" target="_blank" rel="noreferrer">GitHub</a>
        </div>
    </div>
</nav>

@code {
    [Parameter]
    public string Current { get; set; } = string.Empty;

    private string GetNavClass(string key)
    {
        return string.Equals(Current, key, StringComparison.OrdinalIgnoreCase)
            ? "known-site-nav-link active"
            : "known-site-nav-link";
    }

}
