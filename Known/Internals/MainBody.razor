@inherits BaseComponent

@if (Context.UserSetting?.MultiTab == true)
{
    <ReuseTabs Class="@TabsClass" TabPaneClass="kui-body" Body="ChildContent" OnChange="@OnTabChange" />
}
else
{
    <div class="kui-body">
        <ReloadContainer @ref="reload">
            @ChildContent
        </ReloadContainer>
    </div>
}