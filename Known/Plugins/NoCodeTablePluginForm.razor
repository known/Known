@inherits BaseComponent

<KHeadList Class="kui-coding-form" ListTitle="字段配置">
    <Head>
        <KForm SmallLabel SmallRow>
            <KRow>
                <FieldItem Label="页面ID" Required>
                    <AntInput @bind-Value="Model.Data.Id" />
                </FieldItem>
                <FieldItem Label="名称">
                    <AntInput @bind-Value="Model.Data.Name" />
                </FieldItem>
                <FieldItem Label="数据表名" Required>
                    <AntInput @bind-Value="Model.Data.Script" />
                </FieldItem>
                <FieldItem Label="主键字段">
                    <AntInput @bind-Value="Model.Data.IdField" />
                </FieldItem>
            </KRow>
            <KRow>
                <FieldItem Label="数据来源">
                    <AntRadioGroup @bind-Value="Model.Data.Type" Category="NewTable,OldTable" ButtonStyle="RadioButtonStyle.Solid" />
                </FieldItem>
                <FieldItem Label="页面URL">
                    <AntInput @bind-Value="Model.Data.PageUrl" Disabled />
                </FieldItem>
                <FieldItem Label="高级搜索">
                    <AntSwitch @bind-Value="Model.Data.Page.ShowAdvSearch" />
                </FieldItem>
                <FieldItem Label="显示分页">
                    <AntSwitch @bind-Value="Model.Data.Page.ShowPager" />
                </FieldItem>
            </KRow>
        </KForm>
    </Head>
    <Toolbar>
        <KButton Icon="import" Name="导入表" OnClick="OnImportTableAsync" Title="从现有数据库表导入字段。" />
        <KButton Icon="plus" Name="添加字段" OnClick="OnAddField" />
        <KButton Icon="play-circle" Name="执行建表" OnClick="OnExecuteAsync" />
    </Toolbar>
    <List>
        <Tabs ActiveKey="@activeTab" OnChange="OnTabChanged">
            <TabPane Key="Columns" Tab="列表设置">
                <PageColumnTable DataSource="Model.Data.Page.Columns" HidePagination AutoHeight>
                    <StringColumn Title="名称" Width="150" Fixed="ColumnFixPlacement.Left">
                        <AntInput @bind-Value="context.Name" />
                    </StringColumn>
                    <StringColumn Title="代码" Width="150" Fixed="ColumnFixPlacement.Left">
                        <AntInput @bind-Value="context.Id" />
                    </StringColumn>
                    <StringColumn Title="类型" Width="130">@context.Type</StringColumn>
                    <StringColumn Title="查询" Width="70">
                        <AntSwitch @bind-Value="context.IsQuery" />
                    </StringColumn>
                    <StringColumn Title="链接" Width="70">
                        <AntSwitch @bind-Value="context.IsViewLink" />
                    </StringColumn>
                    <StringColumn Title="宽度" Width="100">
                        <AntInteger @bind-Value="context.Width" />
                    </StringColumn>
                    <ActionColumn Title="操作" Align="ColumnAlign.Center" Width="180" Fixed="ColumnFixPlacement.Right">
                        <KButton Name="更多" OnClick="e => OnGridSetting(context)" />
                        <KButton Name="上移" OnClick="e => OnMoveUpColumn(context)" />
                        <KButton Name="删除" OnClick="e => OnDeleteColumn(context)" Danger />
                    </ActionColumn>
                </PageColumnTable>
            </TabPane>
            <TabPane Key="Fields" Tab="表单设置">
                <FormFieldTable DataSource="Model.Data.Form.Fields" HidePagination AutoHeight>
                    <StringColumn Title="名称" Width="150" Fixed="ColumnFixPlacement.Left">
                        <AntInput @bind-Value="context.Name" />
                    </StringColumn>
                    <StringColumn Title="代码" Width="150" Fixed="ColumnFixPlacement.Left">
                        <AntInput @bind-Value="context.Id" />
                    </StringColumn>
                    <StringColumn Title="类型" Width="130">@context.Type</StringColumn>
                    <StringColumn Title="必填" Width="70">
                        <AntSwitch @bind-Value="context.Required" />
                    </StringColumn>
                    <StringColumn Title="只读" Width="70">
                        <AntSwitch @bind-Value="context.ReadOnly" />
                    </StringColumn>
                    <StringColumn Title="跨度" Width="100">
                        <AntInteger @bind-Value="context.Span" />
                    </StringColumn>
                    <ActionColumn Title="操作" Align="ColumnAlign.Center" Width="180" Fixed="ColumnFixPlacement.Right">
                        <KButton Name="更多" OnClick="e => OnFormSetting(context)" />
                        <KButton Name="上移" OnClick="e => OnMoveUpField(context)" />
                        <KButton Name="删除" OnClick="e => OnDeleteField(context)" Danger />
                    </ActionColumn>
                </FormFieldTable>
            </TabPane>
            <TabPane Key="Script" Tab="建表脚本">
                <KCodeView Code="@CodeScript" FileName="@ScriptFile" Lang="csharp" />
            </TabPane>
        </Tabs>
    </List>
</KHeadList>