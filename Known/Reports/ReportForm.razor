@inherits BaseForm<SysReport>

<div class="kui-report-form">
    <KGroupBox Title="@Language.BasicInfo" Style="width:250px;flex-shrink:0;">
        <ReportTypeForm Form="Model" Layout="FormLayout.Vertical">
            <AntRow>
                <DataItem Span="24" Label="报表名称" Required>
                    <AntInput @bind-Value="context.Name" />
                </DataItem>
            </AntRow>
            <AntRow>
                <DataItem Span="12" Label="行数">
                    <AntInteger @bind-Value="context.GridRow" Min="1" Max="6" />
                </DataItem>
                <DataItem Span="12" Label="列数">
                    <AntInteger @bind-Value="context.GridColumn" Min="1" Max="6" />
                </DataItem>
            </AntRow>
            <AntRow>
                <DataItem Span="24" Label="备注">
                    <AntTextArea @bind-Value="context.Note" />
                </DataItem>
            </AntRow>
        </ReportTypeForm>
    </KGroupBox>

    <KGroupBox Title="报表块">
        <div class="kui-report-grid" style="@GetGridStyle()">
            @foreach (var block in blocks)
            {
                var colSpan = block.Width ?? 1;
                var rowSpan = block.Height;
                var isActive = selectedBlock?.Id == block.Id;
                <div class="kui-report-grid-block @(isActive ? "is-active" : "") @(draggingBlock?.Id == block.Id ? "is-dragging" : "")"
                     style="grid-row: @block.Row / span @rowSpan; grid-column: @block.Col / span @colSpan"
                     draggable="true"
                     ondragover="event.preventDefault()"
                     @ondragstart="e => OnDragStart(e, block)"
                     @ondrop="e => OnDrop(e, block)">
                    <div class="kui-report-block-card-header">
                        <span class="kui-report-block-drag">⠿</span>
                        <span class="kui-report-block-type">@block.BlockType.GetDescription()</span>
                        <span class="kui-report-block-title" @onclick="() => OnConfigBlock(block)">@block.Title</span>
                        <AntDropdown Model="GetBlockMenu(block)" />
                    </div>
                    @if (block.BlockType == ReportBlockType.Chart)
                    {
                        <div class="kui-report-block-card-body kui-report-block-chart-skeleton">
                            <div class="kui-skeleton-bar" style="height:40%"></div>
                            <div class="kui-skeleton-bar" style="height:65%"></div>
                            <div class="kui-skeleton-bar" style="height:30%"></div>
                            <div class="kui-skeleton-bar" style="height:80%"></div>
                            <div class="kui-skeleton-bar" style="height:50%"></div>
                            <div class="kui-skeleton-bar" style="height:70%"></div>
                            <div class="kui-skeleton-bar" style="height:35%"></div>
                        </div>
                    }
                    else
                    {
                        <div class="kui-report-block-card-body kui-report-block-table-skeleton">
                            <div class="kui-skeleton-table">
                                <div class="kui-skeleton-table-row kui-skeleton-table-header">
                                    <span></span><span></span><span></span><span></span>
                                </div>
                                <div class="kui-skeleton-table-row"><span></span><span></span><span></span><span></span></div>
                                <div class="kui-skeleton-table-row"><span></span><span></span><span></span><span></span></div>
                                <div class="kui-skeleton-table-row"><span></span><span></span><span></span><span></span></div>
                                <div class="kui-skeleton-table-row"><span></span><span></span><span></span><span></span></div>
                            </div>
                        </div>
                    }
                </div>
            }
            @foreach (var cell in GetEmptyCells())
            {
                <div class="kui-report-grid-empty"
                     style="grid-row: @cell.Row; grid-column: @cell.Col"
                     ondragover="event.preventDefault()"
                     @ondrop="e => OnDropEmpty(e, cell.Row, cell.Col)">
                    <div class="kui-report-grid-empty-actions" @onclick:stopPropagation>
                        <KButton Icon="bar-chart" OnClick="OnAddChartBlock" />
                        <KButton Icon="table" OnClick="OnAddTableBlock" />
                    </div>
                </div>
            }
        </div>
    </KGroupBox>
</div>