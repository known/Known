@inherits BaseForm<SysReport>

<ReportTypeForm Form="Model">
    <AntRow>
        <DataItem Span="8" Label="报表名称" Required>
            <AntInput @bind-Value="context.Name" />
        </DataItem>
        <DataItem Span="16" Label="备注">
            <AntInput @bind-Value="context.Note" />
        </DataItem>
    </AntRow>
</ReportTypeForm>

<KGroupBox Title="报表块">
    <KFlexSpace>
        <div>
            <KButton Icon="bar-chart" Name="添加图表" OnClick="OnAddChartBlock" />
            <KButton Icon="table" Name="添加表格" OnClick="OnAddTableBlock" />
        </div>
    </KFlexSpace>

    @if (blocks != null && blocks.Count > 0)
    {
        <div class="kui-report-blocks">
            @foreach (var block in blocks)
            {
                var isActive = selectedBlock?.Id == block.Id;
                <div class="kui-report-block-card @(isActive ? "is-active" : "")"
                     @onclick="() => OnSelectBlock(block)">
                    <KFlexSpace>
                        <span class="kui-report-block-type">@block.BlockType.GetDescription()</span>
                        <span class="kui-report-block-title">@block.Title</span>
                        <AntDropdown Model="GetBlockMenu(block)" />
                    </KFlexSpace>
                </div>
            }
        </div>
    }
    else
    {
        <Empty Description="@Language["暂无块，请点击上方按钮添加"]" />
    }
</KGroupBox>

@if (selectedBlock != null)
{
    if (selectedBlock.BlockType == ReportBlockType.Chart)
    {
        <KGroupBox Title="图表配置">
            <ReportBlockForm Model="selectedBlock">
                <AntRow>
                    <DataItem Span="8" Label="数据来源">
                        <SelectDataSourceType @bind-Value="context.DataSource.SourceType" />
                    </DataItem>
                    <DataItem Span="8" Label="标题">
                        <AntInput @bind-Value="context.Title" />
                    </DataItem>
                    <DataItem Span="4" Label="宽度(列)">
                        <AntInteger @bind-Value="context.Width" Min="4" Max="24" />
                    </DataItem>
                    <DataItem Span="4" Label="高度">
                        <AntInteger @bind-Value="context.Chart.Height" />
                    </DataItem>
                </AntRow>
                @if (context.DataSource.SourceType == DataSourceType.Table || context.DataSource.SourceType == DataSourceType.SQL)
                {
                    <AntRow>
                        <DataItem Span="24" Label="数据源名称">
                            <AntInput @bind-Value="context.DataSource.SourceName" />
                        </DataItem>
                    </AntRow>
                }
                @if (context.DataSource.SourceType == DataSourceType.Api)
                {
                    <AntRow>
                        <DataItem Span="12" Label="请求地址">
                            <AntInput @bind-Value="context.DataSource.RequestUrl" />
                        </DataItem>
                        <DataItem Span="12" Label="请求方式">
                            <SelectRequestMethodType @bind-Value="context.DataSource.RequestMethod" />
                        </DataItem>
                    </AntRow>
                }
                <AntRow>
                    <DataItem Span="8" Label="图表类型">
                        <SelectChartType @bind-Value="context.Chart.ChartType" />
                    </DataItem>
                    <DataItem Span="8" Label="X轴字段">
                        <AntInput @bind-Value="context.Chart.XField" />
                    </DataItem>
                    <DataItem Span="8" Label="Y轴字段">
                        <AntInput @bind-Value="context.Chart.YField" />
                    </DataItem>
                </AntRow>
                <AntRow>
                    <DataItem Span="8" Label="分组字段">
                        <AntInput @bind-Value="context.Chart.CategoryField" />
                    </DataItem>
                </AntRow>
            </ReportBlockForm>
        </KGroupBox>
    }
    else if (selectedBlock.BlockType == ReportBlockType.Table)
    {
        <KGroupBox Title="表格配置">
            <ReportBlockForm Model="selectedBlock">
                <AntRow>
                    <DataItem Span="8" Label="数据来源">
                        <SelectDataSourceType @bind-Value="context.DataSource.SourceType" />
                    </DataItem>
                    <DataItem Span="8" Label="标题">
                        <AntInput @bind-Value="context.Title" />
                    </DataItem>
                    <DataItem Span="4" Label="宽度(列)">
                        <AntInteger @bind-Value="context.Width" Min="4" Max="24" />
                    </DataItem>
                </AntRow>
                @if (context.DataSource.SourceType == DataSourceType.Table || context.DataSource.SourceType == DataSourceType.SQL)
                {
                    <AntRow>
                        <DataItem Span="24" Label="数据源名称">
                            <AntInput @bind-Value="context.DataSource.SourceName" />
                        </DataItem>
                    </AntRow>
                }
                @if (context.DataSource.SourceType == DataSourceType.Api)
                {
                    <AntRow>
                        <DataItem Span="12" Label="请求地址">
                            <AntInput @bind-Value="context.DataSource.RequestUrl" />
                        </DataItem>
                        <DataItem Span="12" Label="请求方式">
                            <SelectRequestMethodType @bind-Value="context.DataSource.RequestMethod" />
                        </DataItem>
                    </AntRow>
                }
            </ReportBlockForm>
            
            <KFlexSpace>
                <KTitle Text="列定义" />
                <KButton Icon="plus" Name="添加列" OnClick="OnAddColumn" />
            </KFlexSpace>
            <ColumnConfigTable DataSource="selectedBlock.Table.Columns" ScrollY="200px" HidePagination>
                <TableColumn Title="字段名" Width="150" Value="@context.Field">
                    <AntInput @bind-Value="context.Field" />
                </TableColumn>
                <TableColumn Title="标题" Width="150" Value="@context.Title">
                    <AntInput @bind-Value="context.Title" />
                </TableColumn>
                <TableColumn Title="类型" Width="100" Value="@context.Type">
                    <SelectFieldType @bind-Value="context.Type" />
                </TableColumn>
                <TableColumn Title="宽度" Width="80" Value="@context.Width">
                    <AntInteger @bind-Value="context.Width" />
                </TableColumn>
                <TableColumn Title="对齐" Width="80" Value="@context.Align">
                    <SelectAlignType @bind-Value="context.Align" />
                </TableColumn>
                <ActionColumn Title="操作" Width="80" Align="ColumnAlign.Center" Fixed="ColumnFixPlacement.Right">
                    <KButton Icon="delete" OnClick="e => OnDeleteColumn(context)" Danger />
                </ActionColumn>
            </ColumnConfigTable>
        </KGroupBox>
    }
}
