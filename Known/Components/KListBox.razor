@inherits KPanelBase<CodeInfo>

<div class="@ClassName">
    @if (ShowSearch)
    {
        <div class="kui-panel-box-search">
            <Search Value="@searchKey" Placeholder="@Language[Language.TipEnterKeyword]" OnSearch="OnSearch" />
            @if (ShowAddButton)
            {
                <KIcon Icon="plus" Title="@AddButtonText" OnClick="OnAddClick" />
            }
        </div>
    }
    <ul class="kui-panel-box-body">
        @if (items != null && items.Count > 0)
        {
            if (string.IsNullOrWhiteSpace(curItem))
                curItem = items[0].Code;

            foreach (var item in items)
            {
                item.IsActive = curItem == item.Code;

                <li class="@(item.IsActive ? "ant-dropdown-menu-item-selected" : "")" @onclick="e=>OnClick(item)">
                    @if (ItemTemplate != null)
                    {
                        @ItemTemplate(item)
                    }
                    else
                    {
                        @Language[item.Name]
                    }
                </li>
            }
        }
        else
        {
            <Empty>
                @if (ShowAddButton)
                {
                    <KButton Name="@AddButtonText" OnClick="OnAddClick" />
                }
            </Empty>
        }
    </ul>
</div>