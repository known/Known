@inherits BaseComponent

@if (Visible)
{
    <div class="ws-func">
        <div class="ant-card ant-card-bordered" style="height:100%;">
            <div class="ant-card-head">
                <div class="ant-card-head-wrapper">
                    <div class="ant-card-head-title">@Language[Language.HomeCommonFunc]</div>
                    @Tool
                </div>
            </div>
            <div class="ant-card-body">
                @if (Menus == null || Menus.Count == 0)
                {
                    <Empty />
                }
                else
                {
                    foreach (var item in Menus)
                    {
                        var menu = Context.UserMenus?.FirstOrDefault(m => m.Name == item);
                        if (menu == null)
                            continue;

                        <div class="ws-func-menu" @onclick="e => Context.NavigateTo(menu)">
                            <KIcon Icon="@menu.Icon" IsTheme />
                            <KLink Class="name">@Language.GetString(menu)</KLink>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}