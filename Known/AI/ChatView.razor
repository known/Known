@using Microsoft.AspNetCore.Components.Web.Virtualization
@inherits BaseComponent

<div class="kai-chat">
    <div id="kaiScroll" class="kai-chat-infos">
        <ChatVirtualize Items="@(chats.OrderBy(o => o.CreateTime).ToList())">
            @if (context.IsSend)
            {
                <div class="kai-chat-item send">
                    <div class="bubble" style="margin-right:10px;">
                        @if (context.IsEdit)
                        {
                            <div class="edit-box">
                                <AntTextArea Id="kaiInput" @bind-Value="context.Context" Rows="3" AutoSize Disabled="sendding" />
                                <div class="button">
                                    <KButton Name="取消" OnClick="e => context.IsEdit = false" Type="ButtonType.Default" />
                                    <KButton Name="发送" OnClick="e => OnEditSend(context)" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="action ant-btn-link">
                                <KIcon Icon="copy" Title="复制" OnClick="this.Callback<MouseEventArgs>(e => OnCopy(context.Context))" />
                                <KIcon Icon="edit" Title="编辑" OnClick="this.Callback<MouseEventArgs>(e => context.IsEdit = true)" />
                            </div>
                            <div class="message">
                                @if (Message != null)
                                {
                                    @Message.Invoke(context)
                                }
                                else
                                {
                                    <pre>@context.Context</pre>
                                }
                            </div>
                        }
                    </div>
                    <img class="avatar" src="@CurrentUser?.AvatarUrl" />
                </div>
            }
            else
            {
                <div class="kai-chat-item receive">
                    <img class="avatar" src="@(Agent?.Avatar ?? "./favicon.png")" />
                    <div class="bubble" style="margin-left:10px;">
                        <div class="message">
                            @if (Message != null)
                            {
                                @Message.Invoke(context)
                            }
                            else
                            {
                                <pre>@context.Context</pre>
                            }
                        </div>
                        <div class="action ant-btn-link">
                            <KIcon Icon="copy" Title="复制" OnClick="this.Callback<MouseEventArgs>(e => OnCopy(context.Context))" />
                        </div>
                    </div>
                </div>
            }
        </ChatVirtualize>
        <div class="new">
            <KIcon Icon="message" Name="开启新对话" OnClick="this.Callback<MouseEventArgs>(e => OnNew())" />
        </div>
    </div>
    <div class="kai-chat-send">
        @if (Toolbar != null)
        {
            <div class="kai-chat-toolbar">@Toolbar</div>
        }
        <AntTextArea Id="kaiInput" @bind-Value="message" OnInput="OnMessageChange" OnKeyDown="OnMessageKeyDown" Rows="3" Placeholder="@Placeholder" AutoSize Disabled="sendding" />
        <div class="@ActionClass">
            <KIcon Icon="arrow-up" Title="@TitleSend" OnClick="this.Callback<MouseEventArgs>(async e => await OnSend())" />
        </div>
        <div class="tips">内容由 AI 生成，请仔细甄别</div>
    </div>
</div>